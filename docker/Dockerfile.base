# Worker runtime base image.
#
# Provides everything a project's pipeline.py needs to RUN — but none of the control
# plane. The control-plane image builds FROM this (see docker/Dockerfile).
#
# Pinned to Python 3.11: current AT projects still `from distutils.version import
# StrictVersion`, and distutils was removed from the stdlib in 3.12.
FROM python:3.11-slim

# --- wget-at: the archiving engine -------------------------------------------------
# wget-at (patched GNU Wget + Lua + WARC/zstd) is the actual crawler. It is a separately
# maintained C program, NOT seesaw — projects invoke it via their .lua scripts. We copy
# the prebuilt binary from grab-base for now.
# TODO: optionally build from source (ArchiveTeam/wget-lua) to drop the external image dep.
COPY --from=atdr.meo.ws/archiveteam/grab-base:gnutls /usr/local/bin/wget-lua /usr/local/bin/wget-at

# --- OS deps the pipelines shell out to --------------------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      rsync curl ca-certificates git zstd \
 && rm -rf /var/lib/apt/lists/*

# --- Python deps that project pipeline.py files import directly --------------------
# (ours to provide, not ours to implement: projects `import tornado/requests/zstandard`.)
RUN pip install --no-cache-dir \
      "httpx>=0.27" \
      "tornado>=6.4" \
      "requests>=2.32" \
      "zstandard>=0.22"

# --- our clean-room runtime, importable as `seesaw` --------------------------------
RUN useradd -m --uid 1000 warrior
WORKDIR /home/warrior
COPY --chown=warrior:warrior worker/ /opt/carousel/worker/
# Expose worker/seesaw as top-level `import seesaw` for project pipelines.
ENV PYTHONPATH=/opt/carousel:/opt/carousel/worker
USER 1000
RUN mkdir -p data projects
