# Worker/runtime base image: ArchiveTeam's grab-base (for wget-at + its shared libs and
# the crawl toolchain), with ONE modern Python — 3.11 — made the default interpreter for
# everything (control plane and workers alike). 3.11 is the newest Python that still ships
# stdlib distutils, which the existing project pipelines we run unchanged import.
#
# grab-base is linux/amd64, so build for amd64:
#   docker build --platform linux/amd64 -f docker/Dockerfile.base -t carousel-base .
FROM atdr.meo.ws/archiveteam/grab-base

# grab-base's entrypoint is run-pipeline3; clear it so we invoke our own worker.
ENTRYPOINT []

# Install Python 3.11 (+ distutils, which Debian unbundles) and make it the default
# python3/python, shadowing grab-base's source-built 3.9. wget-at is a binary and does not
# depend on the Python version.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-dev python3-distutils python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
 # Debian marks its Python externally-managed (PEP 668), which blocks pip — including
 # a project's warrior-install.sh. Remove the marker so pip works in this container.
 && rm -f /usr/lib/python3.11/EXTERNALLY-MANAGED

# Deps project pipelines import directly (tornado/requests/zstandard) + our tracker client.
RUN python3 -m pip install --no-cache-dir \
      "httpx>=0.27" "tornado>=6.4" "requests>=2.32" "zstandard>=0.22"

# Make wget-at discoverable at the paths project pipelines probe, and create data dirs.
# Projects ask for a specific TLS variant (nss/openssl/gnutls); point them all at the
# bundled wget-lua (wiring the distinct per-variant binaries is a later refinement).
RUN mkdir -p /home/warrior/data /home/warrior/projects \
 && for v in wget-at wget-at-gnutls wget-at-openssl wget-at-nss; do \
      ln -sf /usr/local/bin/wget-lua /home/warrior/data/$v; \
    done

# Our worker code: importable as `worker`, and `seesaw` via PYTHONPATH.
COPY worker/ /opt/carousel/worker/
ENV PYTHONPATH=/opt/carousel:/opt/carousel/worker

WORKDIR /home/warrior
